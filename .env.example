# ---------------------------------------------------------------- server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set when running behind a load balancer, so X-Forwarded-For is trusted.
TRUST_PROXY=false

# Backing stores. Both are optional: without them the platform runs fully
# in memory, which is what local development and the test suite use.
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://strangerchat:strangerchat@localhost:5432/strangerchat

# Enables /api/admin/stats and /api/admin/cost. Leave unset to disable them.
# ADMIN_TOKEN=change-me

# ----------------------------------------------------- matching (§5, §7)
# The wait ladder, in milliseconds.
MATCH_TIER1_MS=5000          # same language + shared interest
MATCH_TIER2_MS=10000         # same language, any interest
MATCH_TIER3_MS=20000         # any language, with translation; AI offer point
# Scale the ladder by how fast each language actually matches.
MATCH_DYNAMIC_THRESHOLDS=true

# Scoring weights.
SCORE_SAME_LANGUAGE=100
SCORE_FIRST_INTEREST=30
SCORE_EXTRA_INTEREST=10
SCORE_NEVER_MATCHED=10
SCORE_TRANSLATION_PENALTY=-20
SCORE_RECENTLY_LEFT=-50
SCORE_BLOCKED=-9999
SCORE_ABUSE_CLUSTER=-9999

# -------------------------------------------------- translation (§8–§15)
# auto (default) picks Google when credentials exist, otherwise a local echo
# provider that marks strings instead of translating them. google | echo | none.
TRANSLATION_PROVIDER=auto

# Option A — API key, uses Cloud Translation v2.
# GOOGLE_TRANSLATE_API_KEY=

# Option B — service account, uses Cloud Translation v3. Preferred in production.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-translate.json
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_TRANSLATE_LOCATION=global

# Cost control (§13). Google's free tier is 500k characters per month for
# standard NMT; this cap is per day and applies platform-wide.
TRANSLATION_DAILY_CHAR_LIMIT=500000
TRANSLATION_WARN_RATIO=0.8
TRANSLATION_COST_PER_M_CHARS=20
TRANSLATION_CACHE_TTL_S=900
TRANSLATION_CACHE_MAX_CHARS=120

# ------------------------------------------------------- AI bot (§16–§28)
BOT_ENABLED=true
# launch = automatic fallback when no human is available.
# mature = the AI stays available, but only when the user asks for it (§43).
BOT_MODE=launch
# auto picks Anthropic, then a local OpenAI-compatible server, then scripted
# offline replies. anthropic | openai-compatible | scripted.
BOT_PROVIDER=auto

# Cloud AI
# ANTHROPIC_API_KEY=
BOT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
BOT_INPUT_COST_PER_MTOK=1
BOT_OUTPUT_COST_PER_MTOK=5

# Local AI — anything speaking the OpenAI chat-completions API.
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_MODEL=llama3.1

# Usage limits (§25). Deliberately generous at launch.
BOT_SESSION_LIMIT_MS=600000
BOT_COOLDOWN_MS=120000
BOT_DAILY_MESSAGE_LIMIT=20000
BOT_DAILY_COST_LIMIT_USD=25
